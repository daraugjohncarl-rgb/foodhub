# Copy to .env (never commit .env). All values below are placeholders.

# --- Runtime ---------------------------------------------------------------------------------
APP_ENV=development            # set to "production" on every real deployment
PORT=8000

# --- Database --------------------------------------------------------------------------------
# Production: the Supabase PostgreSQL connection string (Dashboard -> Project Settings -> Database).
# Prefer the pooled connection string and a dedicated database role. Never commit the real value.
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>
# Local MySQL/XAMPP development alternative (ignored when DATABASE_URL is set):
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=pos

# --- Authentication --------------------------------------------------------------------------
# REQUIRED in production, at least 32 random characters, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-a-random-48-char-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Network / browser security --------------------------------------------------------------
# Explicit origins allowed to call the API cross-origin (leave empty when the UI is served by this app).
ALLOWED_ORIGINS=
# Host names the app answers to in production (comma separated), e.g. pos.example.com
ALLOWED_HOSTS=
# Number of reverse proxies you operate in front of the app (0 = none). Used so rate limits see the real
# client IP without trusting a spoofable X-Forwarded-For. Verify the value for your platform.
TRUSTED_PROXY_COUNT=0
# Set true only if you deliberately want /docs and /openapi.json exposed in production.
ENABLE_API_DOCS=false

# --- Behaviour switches ------------------------------------------------------------------------
# Business decision pending: auto-open a zero-cash shift when a sale arrives with no open shift.
AUTO_OPEN_SHIFT=true
RATE_LIMIT_ENABLED=true

# --- Development only (ignored when APP_ENV=production) ---------------------------------------
SEED_DEMO_DATA=false           # true creates demo users with well-known passwords
DB_AUTO_CREATE_TABLES=true     # create_all on startup
