# Inbox POS configuration. Copy to fastapi/.env for local development; on Render/Docker set these as environment
# variables instead. Real values never go into git (.env is git-ignored).

# development | test | staging | production
#   production: API docs off, no demo data, no default CORS origins.
APP_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Either a full URL (Render/Neon/Supabase provide one)...
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/inbox_pos_dev
# ...or the individual parts (used only when DATABASE_URL is empty). There are no defaults on purpose.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=inbox_pos_dev
# DB_USER=postgres
# DB_PASS=

# Only for the one-off migration 0002 of a database that already holds data (required then; see DEPLOYMENT.md 1.3):
#   LEGACY_DB_TIMEZONE  = the PostgreSQL server's timezone when the old data was written (SHOW timezone)
#   LEGACY_APP_TIMEZONE = the OS timezone of the machine that ran the old app (Render: UTC)
# LEGACY_DB_TIMEZONE=
# LEGACY_APP_TIMEZONE=

# ── Authentication ───────────────────────────────────────────────────────────
# REQUIRED. At least 32 random characters; the app refuses to start otherwise. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out (all existing tokens become invalid).
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Creates the first SUPER_ADMIN on start-up if none exists (min. 10 chars; must be changed at first login).
# Set it for one start-up only, then remove it.
# INITIAL_SUPERADMIN_USERNAME=superadmin
# INITIAL_SUPERADMIN_PASSWORD=

PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_IP_WINDOW_MINUTES=15

# ── Web ──────────────────────────────────────────────────────────────────────
# Extra browser origins allowed to call the API (comma-separated). The bundled frontend is same-origin, so this
# is normally empty in production. '*' is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Override the defaults (on outside production, off in production):
# ENABLE_API_DOCS=true
# SEED_DEMO_DATA=true

# ── Business rules ───────────────────────────────────────────────────────────
BUSINESS_TIMEZONE=Asia/Manila
# Tax added on top of the (discounted) subtotal, e.g. 0.12. Menu prices are VAT-inclusive, so the default is 0.
TAX_RATE=0
POS_MAX_LINE_QUANTITY=999
CUSTOMER_ORDER_MAX_ITEMS=30
CUSTOMER_ORDER_MAX_QUANTITY=50
CUSTOMER_ORDERS_PER_IP_PER_10_MIN=10
PRODUCT_IMAGE_MAX_BYTES=307200
ACTIVITY_LOG_MIN_RETENTION_DAYS=90

# ── Tests (never point these at real data) ───────────────────────────────────
# TEST_DATABASE_URL=postgresql+psycopg://USER@127.0.0.1:5432/inbox_pos_test
